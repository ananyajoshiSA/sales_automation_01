{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker that Workers Builds deploys to (Workers & Pages → sales-automation-01).
  "name": "sales-automation-01",
  // The target Cloudflare account (not a secret): pins deploys to it, so a login to another
  // account can't land the Worker there.
  "account_id": "5f3e897557136f4ccbe8d884329f1c58",
  "main": "src/index.ts",
  // Served at https://sales-automation-01.<subdomain>.workers.dev, behind Cloudflare Access.
  "workers_dev": true,
  // No per-version preview URLs: they would be extra hostnames without the Access policy.
  "preview_urls": false,
  "compatibility_date": "2025-09-01",
  // Switched off 2026-10-14 (user's request): no cron, so nothing reads LeadSquared. To switch back on,
  // restore ["* * * * *"] (one small task per run) and set DASHBOARD_OFF to "0".
  "triggers": { "crons": [] },
  // Dashboard page. The Worker runs first on every request so DASHBOARD_OFF can close the page too.
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sales_dashboard",
      // Created in the target account's dashboard (D1 -> Create Database), 2026-10-09.
      "database_id": "db058839-b873-41ee-8bc8-198482d4b56e",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // "1" switches the whole dashboard off: no sync, every page and /api/* route says it is switched off.
    "DASHBOARD_OFF": "1",
    "LEADSQUARED_HOST": "api-in21.leadsquared.com",
    "CALL_RECORDS_PER_RUN": "200",
    "CALL_PAGE_SIZE": "100",
    "ZIP_RECORDS_PER_RUN": "80",
    "ZIP_PAGE_SIZE": "40",
    "LEAD_PAGE_SIZE": "500",
    "ENROLL_LEADS_PER_RUN": "12",
    "WRITE_BUDGET": "90000",
    "READ_BUDGET": "4500000",
    "SUMMARY_TTL_SECONDS": "60",
    // "1" serves the conversation intelligence snapshots (/api/ci/*, ci.html); anything else answers 404.
    "CI_ENABLED": "1",
    // From Zero Trust once the Access app exists (not secrets). Empty = the API refuses all data.
    "ACCESS_TEAM_DOMAIN": "still-credit-1ce4.cloudflareaccess.com",
    "ACCESS_AUD": "fb2121250a3b3e65a465eba6eb342a6b5e44e6c39b667297bb2d0202f792d14f"
  },
  // Secrets (never in this file): LEADSQUARED_ACCESS_KEY, LEADSQUARED_SECRET_KEY, RUN_TOKEN
  "observability": { "enabled": true }
}
