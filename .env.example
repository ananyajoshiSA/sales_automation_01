# LeadSquared — copy to .env (never commit .env) or set in the cloud environment settings
LEADSQUARED_HOST=https://api-in21.leadsquared.com/v2/
LEADSQUARED_ACCESS_KEY=
LEADSQUARED_SECRET_KEY=

# Centralized call-transcript API
TRANSCRIPT_API_BASE=https://centralized-transcript-api.altlapps.com/api/v1/
TRANSCRIPT_API_KEY=
# Max API requests per run; hard ceiling 9 (strictly fewer than 10)
TRANSCRIPT_MAX_REQUESTS_PER_RUN=9
