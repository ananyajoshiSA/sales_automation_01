 "playbook": {
  "Lawyers wanting work from home": {
   "pain": "the day belongs to the courtroom, the commute or the office. Income depends on being physically present. A small-city pincode caps the practice. Even good jobs have no flexibility, and \"work from home\" in India usually means lower pay.",
   "open_with": "a remote income that runs alongside what they do now — 2 to 3 hours a day — with the option to grow it into a full remote role.",
   "story": "Tushar Katheria (Kanpur litigator, U K retainer) or Sakshi Kumari (Patna). Never repeat a story in the same call.",
   "day": ""
  },
  "Company secretaries": {
   "pain": "doing the same annual cycle every year, capped growth, seen as \"just filings\" despite carrying real responsibility, pay that does not match the accountability, and no route beyond the Indian market.",
   "open_with": "side income in dollars on the skills they already have, then the G C C and in-house door — unless they are an in-house C S talking about their role or salary band: then use B2 and lead with the career door",
   "story": "Saumen Chakraborty (compliance, M S A drafting, alongside a regular job) or Gopal Dutta (L L C incorporations and by-laws alongside his practice).",
   "day": ""
  },
  "Law graduates": {
   "pain": "no replies to internship or job emails, firms want two years P Q E, only N L U graduates and second-generation lawyers get looked at, seniors who do not pay and do not teach, first job paying almost nothing.",
   "open_with": "the first paid project and the track record it builds — 15 to 60 thousand rupees a month on two to three hours a day alongside college or a first job — and how that track record reads on a C V.",
   "story": "Tanu Sharma (first US startup paralegal project within a month, in her fourth year) or Sakshi Kumari (joined in her second year, now over a lakh a month at a Missouri firm).",
   "day": ""
  },
  "Women lawyers": {
   "pain": "",
   "open_with": "control — of hours, of income, of where they work — with a first paid result within a few months. Treat it as a career move, never as a \"women's hobby\", never as a compromise.",
   "story": "Taru Agarwal (full-time paralegal at a Georgia firm, now preparing for the California Bar) or Sakshi Kumari. Never mention anyone's health or personal circumstances.",
   "day": ""
  },
  "General": {
   "pain": "usually one of — income that has plateaued, a feeling that the Indian market is saturated, or wanting to freelance for US clients without knowing where to start.",
   "open_with": "the market-size gap and the entry rate, then ask what pulls them more — side income or a door to an M N C, a G C C or a firm.",
   "story": "Supreet Prasad (litigated in Delhi for five years, now runs his own firm with Indian and US clients).",
   "day": ""
  }
 },
